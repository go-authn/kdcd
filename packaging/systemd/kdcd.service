# SPDX-License-Identifier: BSD-3-Clause
#
# kdcd as a systemd service: the reference for a manual install (README,
# "Running it") and for packagers. Its hardening is authn-bridge's
# (go-authn/bridge packaging/systemd/authn-bridge.service), less what a KDC does
# not need and plus what it does.
#
#   /usr/local/bin/kdcd    the binary
#   /etc/kdcd/kdcd.hcl     the configuration: root:kdcd 0640, no secret in it
#   /etc/kdcd/*            the keytab and the mint key: kdcd:kdcd 0600. Group
#                          read is REFUSED by the daemon, on purpose.
#
# The user comes from packaging/sysusers.d/kdcd.conf, not DynamicUser=: the
# keytab and the mint key are made before the first start, live for years, and
# must keep one owner across reinstalls and restores from backup.
#
# Port 88 is privileged. The unit grants CAP_NET_BIND_SERVICE and nothing else;
# a realm on an unprivileged port (listen { address = "...:8888" }) can remove
# both capability lines. PrivateUsers is not set: a user namespace would make
# the capability one of the namespace, which binds no host port.
#
# No ExecReload: the daemon does not reload, so a change is `systemctl restart
# kdcd`. SIGTERM stops it within its 10-second shutdown.

[Unit]
Description=kdcd, a Kerberos KDC for one realm (go-authn/kdc)
Documentation=https://github.com/go-authn/kdcd#readme
# A directory behind users "sql" or users "ldap" is opened before it listens,
# and the daemon refuses to start without it.
Wants=network-online.target
After=network-online.target

[Service]
Type=exec
User=kdcd
Group=kdcd
ExecStart=/usr/local/bin/kdcd --config /etc/kdcd/kdcd.hcl
# A configuration that does not check is not worth starting.
ExecStartPre=/usr/local/bin/kdcd check --config /etc/kdcd/kdcd.hcl
Restart=on-failure
RestartSec=5s
TimeoutStopSec=20s

# Optional: instead of keytab_file / key_file, a sealed credential
# (keytab_from = "systemd-creds:kdc-keytab", key_from = "systemd-creds:mint-key").
# Seal with `systemd-creds encrypt --with-key=host+tpm2 --name=kdc-keytab IN OUT`
# (never a bare --tpm2-pcrs=7). If the TPM2 chip, the host key or the firmware
# measurements change, the service fails closed: re-seal from the offline copy
# of the keytab, then `systemctl restart kdcd`.
#LoadCredentialEncrypted=kdc-keytab:/etc/credstore.encrypted/kdc-keytab.cred
#LoadCredentialEncrypted=mint-key:/etc/credstore.encrypted/mint-key.cred

ConfigurationDirectory=kdcd
ConfigurationDirectoryMode=0750
UMask=0077

# One privilege, to bind port 88, and no way to gain another.
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
RestrictSUIDSGID=yes

# The file system: read-only, no home, a /tmp of its own, no devices. It writes
# nothing: the keytab and the directory are read, never changed.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
DevicePolicy=closed
ProtectProc=invisible
ProcSubset=pid
RemoveIPC=yes
PrivateIPC=yes

# The kernel and the host.
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictNamespaces=yes

# The network: UDP and TCP for the KDC and the mint listener, TCP to the
# directory. Nothing else (no netlink, no raw packets).
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

# System calls: what a service needs, less privileged and resource-setting
# calls. Refused with EPERM rather than a kill, so that the Go runtime's
# optional calls fail softly.
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
